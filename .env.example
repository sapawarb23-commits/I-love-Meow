# Copy this file to .env for local Docker Compose use, or set these as
# real secrets in your host's env/secrets manager for production
# (Render/Railway dashboard, AWS Secrets Manager, Docker Swarm secrets,
# Kubernetes Secrets, etc). Never commit a real .env file — it's gitignored.

# ---------- core ----------
NODE_ENV=production
PORT=3000

# Signs session tokens (auth.js). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotating this invalidates every existing session — treat it like a
# password, store it in a secrets manager, never in git.
SESSION_SECRET=change-me-to-a-long-random-value

# Set to 1 only when Node is running behind a reverse proxy (nginx in this
# repo's docker-compose.yml) that sets X-Forwarded-For. Leave unset/0 if
# Node is directly internet-facing, or rate limiting can be IP-spoofed.
TRUST_PROXY=1

# ---------- domain / SSL (nginx + certbot) ----------
DOMAIN=example.com
CERTBOT_EMAIL=admin@example.com

# ---------- Redis (rate limiting + caching) ----------
# Leave unset for local dev — falls back to an in-memory store automatically.
# In docker-compose.yml this resolves to the `redis` service.
REDIS_URL=redis://redis:6379

# ---------- Postgres ----------
# Provisioned in docker-compose.yml for teams migrating off SQLite (see
# README's "Why no Express/Prisma" migration table). The app does not read
# from Postgres today — this is the connection string the future db.js
# swap would use. Safe to leave the postgres service stopped until then.
DATABASE_URL=postgres://ilovemeow:change-me@postgres:5432/ilovemeow
POSTGRES_USER=ilovemeow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ilovemeow

# ---------- rate limiting ----------
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_SECONDS=60

# ---------- observability ----------
# Sentry error tracking — leave unset to disable entirely (no-op).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Shared secret nginx forwards as X-Metrics-Token so /metrics can't be
# scraped by anyone who reaches the container directly. Leave unset in
# local dev.
METRICS_TOKEN=

# Grafana admin login (docker-compose.yml grafana service)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# ---------- image CDN (optional) ----------
# Leave all three unset to keep using plain image_url text fields — the
# app works fully without Cloudinary. Set all three to enable real signed
# direct-to-Cloudinary uploads (cloudinary.js) with automatic CDN delivery.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- backups ----------
# Optional: if set, scripts/backup.sh uploads to an S3-compatible bucket
# (AWS S3, Cloudflare R2, Backblaze B2) after taking a local snapshot.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUP_RETENTION_DAYS=14
