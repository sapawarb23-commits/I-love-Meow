# This file is a template: nginx's official docker-entrypoint runs
# envsubst on it at container start (see docker-compose.yml's nginx
# service, which mounts this directory to /etc/nginx/templates) and writes
# the result to /etc/nginx/conf.d/ilovemeow.conf. Only ${DOMAIN} is
# substituted — nginx's own $variables (like $host, $remote_addr) are left
# alone because no environment variable shares those names.
#
# First-time SSL setup: run scripts/init-letsencrypt.sh once to obtain a
# real certificate before the https server block below will have anything
# to serve. Until then, comment out the https block and drop the redirect,
# or the container will fail to start on a missing cert file.

# ---------- HTTP: ACME challenge + redirect to HTTPS ----------
server {
  listen 80;
  listen [::]:80;
  server_name ${DOMAIN} www.${DOMAIN};

  # Let's Encrypt HTTP-01 challenge files, served over plain HTTP as required.
  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://${DOMAIN}$request_uri;
  }
}

# ---------- HTTPS: real traffic ----------
server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name ${DOMAIN} www.${DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
  include /etc/nginx/snippets/ssl-params.conf;

  # Redirect the bare www host to the apex (or flip this if you prefer www).
  if ($host = www.${DOMAIN}) {
    return 301 https://${DOMAIN}$request_uri;
  }

  limit_conn perip 40;

  # ---- security headers ----
  # Duplicated at the app layer (security.js) on purpose — defense in
  # depth, and these still apply to nginx's own error pages / static
  # cache responses that short-circuit before reaching Node.
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()" always;

  # ---- Prometheus scrape endpoint: internal network only ----
  location = /metrics {
    allow 172.16.0.0/12;   # Docker's default bridge/user-network ranges
    allow 127.0.0.1;
    deny all;
    proxy_pass http://ilovemeow_app;
    proxy_set_header Host $host;
  }

  # ---- auth endpoints: tighter rate limit (also throttled at app layer) ----
  location ~ ^/api/auth/(login|register) {
    limit_req zone=auth burst=3 nodelay;
    limit_req_status 429;
    proxy_pass http://ilovemeow_app;
    include /etc/nginx/snippets/proxy-common.conf;
  }

  # ---- everything else under /api ----
  location /api/ {
    limit_req zone=general burst=40 nodelay;
    limit_req_status 429;
    proxy_pass http://ilovemeow_app;
    include /etc/nginx/snippets/proxy-common.conf;
  }

  location = /health {
    proxy_pass http://ilovemeow_app;
    proxy_set_header Host $host;
    access_log off;
  }

  # ---- static assets: cache aggressively, fall through to Node otherwise ----
  location / {
    limit_req zone=general burst=40 nodelay;
    proxy_pass http://ilovemeow_app;
    include /etc/nginx/snippets/proxy-common.conf;
  }

  location ~* \.(?:css|js|svg|png|jpg|jpeg|gif|ico|woff2?)$ {
    proxy_pass http://ilovemeow_app;
    include /etc/nginx/snippets/proxy-common.conf;
    expires 7d;
    add_header Cache-Control "public, max-age=604800, immutable";
  }
}
